# =============================================================================
# Malam OS Backend Configuration Template
# Copy this file to .env and configure for your environment
# =============================================================================

# Server Environment (development | staging | production)
ENVIRONMENT=development

# Database URL (SQLite default, PostgreSQL for production)
DATABASE_URL=sqlite:///./malam_agency.db
# DATABASE_URL=postgresql://user:password@localhost:5432/malam_os

# CORS Allowed Origins (Comma-separated list, NO wildcard in production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & Session
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Google Workspace / Drive Integration
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
GOOGLE_DRIVE_MAIN_FOLDER_ID=1dhuayx660p7NyCnxeAXTQ0tPZUfuy8j8
GOOGLE_SHEET_TEMPLATE_ID=1ovyYQ1VcWBS9LhUg9IuAucHwE9qCGjPOOIKYsW25pZI
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbw6rpEZCNIe1bel7SiBRdS0auLVOP5K36oEh2su-ypwEEJpIui_0PJ96Bi4eRZZy5-7/exec

# Logging Level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
